# Peritoneal Dialysis Adequacy Agent - Environment Configuration
# Copy this file to .env and modify as needed

# Audit Trail Configuration
# Set a persistent secret key for HMAC-SHA256 audit trail integrity.
# If not set, a random key will be generated for each session.
# IMPORTANT: For production deployments, set this to a secure random value.
AUDIT_SECRET_KEY=

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# LLM Provider Configuration
# Options: mock, ollama, claude, openai
LLM_PROVIDER=mock
