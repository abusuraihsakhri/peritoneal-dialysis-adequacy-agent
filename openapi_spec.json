{
  "openapi": "3.1.0",
  "info": {
    "title": "Peritoneal Dialysis Adequacy Agent API",
    "description": "Educational PET and weekly urea Kt/V calculators plus legacy generic audit demonstrations. Not a validated clinical decision support system.",
    "version": "2.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON operational counters (not Prometheus text)",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy generic metric audit (not a PET/Kt/V clinical assessment)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock supervisor query (not validated clinical advice)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/pet": {
      "post": {
        "summary": "Calculate four-hour PET D/P creatinine",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "dialysate_creatinine_4h",
                  "plasma_creatinine"
                ],
                "properties": {
                  "dialysate_creatinine_4h": {
                    "type": "number",
                    "minimum": 0
                  },
                  "plasma_creatinine": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "D/P ratio and historical descriptive band"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/ktv": {
      "post": {
        "summary": "Calculate weekly urea Kt/V from daily dialysate and optional urine collections",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "serum_urea",
                  "dialysate_urea",
                  "daily_drain_volume_l",
                  "urea_distribution_volume_l"
                ],
                "properties": {
                  "serum_urea": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "dialysate_urea": {
                    "type": "number",
                    "minimum": 0
                  },
                  "daily_drain_volume_l": {
                    "type": "number",
                    "minimum": 0
                  },
                  "urea_distribution_volume_l": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "urine_urea": {
                    "type": "number",
                    "minimum": 0
                  },
                  "daily_urine_volume_l": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Peritoneal, residual renal and total weekly Kt/V"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    }
  }
}
